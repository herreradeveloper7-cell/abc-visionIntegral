---
import { ArrowRight, Phone } from "lucide-astro";

const navItems = [
  { label: "Inicio", href: "/" },
  { label: "Servicios", href: "/servicios" },
  { label: "Proyectos", href: "/proyectos" },
  { label: "Nosotros", href: "/nosotros" },
  { label: "Contacto", href: "/contacto" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActivePath = (href: string) => {
  const normalizedHref = href.replace(/\/$/, "") || "/";
  return normalizedHref === "/"
    ? currentPath === "/"
    : currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};
---

<header class="absolute left-0 top-0 z-50 w-full">
  <div class="flex h-24 items-start pl-10 md:pl-16 lg:pl-24">
    <a href="/" class="relative z-10 mt-4 flex w-36 shrink-0 items-start md:w-44 lg:w-52">
      <img
        src="/images/logo-abc.png"
        alt="ABC Vision Integral"
        class="h-auto w-full"
      />
    </a>

    <nav class="header-nav-items hidden items-center justify-center gap-8 font-title text-sm font-bold text-brand-black lg:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "relative py-2 transition-colors after:absolute after:bottom-0 after:left-1/2 after:h-0.5 after:-translate-x-1/2 after:rounded-full after:bg-brand-orange after:transition-all after:duration-200 hover:text-brand-orange hover:after:w-full",
              isActivePath(item.href) ? "text-brand-orange after:w-full" : "after:w-0",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-nav-panel ml-16 flex min-w-0 flex-1 items-center justify-end bg-brand-white/95 px-6 py-4 pr-8 shadow-[0_10px_30px_rgba(0,0,0,0.08)] backdrop-blur md:ml-20 md:pr-14 lg:ml-24 lg:pr-20 lg:pl-10">
      <a
        href="tel:+573001234567"
        class="header-phone-cta inline-flex h-12 items-center gap-3 px-8 font-title text-xs font-bold text-brand-white transition-colors"
      >
        <span class="relative z-10 grid size-5 place-items-center rounded-full text-brand-orange">
          <Phone size={16} strokeWidth={2.5} aria-hidden="true" />
        </span>
        <span class="relative z-10 hidden whitespace-nowrap sm:inline">+51 987 312 602</span>
        <ArrowRight size={16} strokeWidth={2.5} class="relative z-10 text-brand-orange" aria-hidden="true" />
      </a>
    </div>
  </div>
</header>

<style>
  .header-nav-panel {
    position: relative;
    z-index: 10;
  }

  .header-nav-items {
    position: absolute;
    top: 1.5rem;
    left: 50vw;
    transform: translateX(-50%);
    z-index: 30;
  }

  .header-nav-panel::before {
    content: "";
    position: absolute;
    bottom: 0;
    left: -4.25rem;
    z-index: -1;
    width: 7rem;
    height: 100%;
    background:
      linear-gradient(115deg, rgba(0, 0, 0, 0.28) 0 2px, transparent 16px),
      linear-gradient(115deg, rgba(0, 0, 0, 0.18), transparent 38%),
      rgba(255, 255, 255, 0.96);
    clip-path: polygon(42% 0, 100% 0, 58% 100%, 0 100%);
    filter: drop-shadow(-10px 10px 10px rgba(0, 0, 0, 0.24));
  }

  .header-phone-cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    clip-path: polygon(1.2rem 0, 100% 0, calc(100% - 1.2rem) 100%, 0 100%);
    transition: filter 180ms ease, transform 180ms ease;
  }

  .header-phone-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-brand-black);
    transition: background-color 180ms ease, box-shadow 180ms ease;
  }

  .header-phone-cta::after {
    content: "";
    position: absolute;
    top: -35%;
    left: -35%;
    z-index: 1;
    width: 28%;
    height: 170%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
    transform: translateX(-120%) skewX(-22deg);
    transition: transform 520ms ease;
  }

  .header-phone-cta:hover::before {
    background: var(--color-brand-dark);
    box-shadow:
      0 0 16px rgba(249, 146, 40, 0.34),
      0 16px 30px rgba(0, 0, 0, 0.26);
  }

  .header-phone-cta:hover {
    filter: brightness(1.08);
    transform: translateY(-2px) scale(1.02);
  }

  .header-phone-cta:hover::after {
    transform: translateX(520%) skewX(-22deg);
  }

  @media (max-width: 767px) {
    .header-nav-panel::before {
      left: -2rem;
      width: 4rem;
    }
  }
</style>
