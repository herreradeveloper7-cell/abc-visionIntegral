---
import { Award, BadgeCheck, Building2, UsersRound } from "lucide-astro";

const stats = [
  {
    icon: Award,
    value: "+10",
    label: "Anos de experiencia",
  },
  {
    icon: Building2,
    value: "+450",
    label: "Proyectos exitosos",
  },
  {
    icon: UsersRound,
    value: "+120",
    label: "Marcas que confian",
  },
  {
    icon: BadgeCheck,
    value: "100%",
    label: "Comprometidos con la calidad",
  },
];
---

<section class="about-hero-section">
  <div class="about-hero-grid">
    <div class="about-copy">
      <div class="about-copy-inner">
        <div class="about-copy-line" aria-hidden="true"></div>

        <p class="about-eyebrow">Somos ABC Vision Integral</p>
        <h1>
          Una marca que disena, produce e instala con
          <span>precision.</span>
        </h1>
        <p class="about-summary">
          Combinamos creatividad, tecnologia y precision para producir piezas visuales que hacen visible el valor de tu marca.
        </p>
      </div>
    </div>

    <div class="about-visual" aria-label="Historia de ABC Vision Integral">
      <div class="story-layer story-layer-gray"></div>
      <div class="story-layer story-layer-silver"></div>
      <div class="story-layer story-layer-orange"></div>
      <div class="story-layer story-layer-black"></div>

      <div class="story-panel">
        <div class="story-copy">
          <h2>Nuestra historia</h2>
          <div aria-hidden="true"></div>
          <p>
            ABC Vision Integral nace de la pasion por transformar ideas en experiencias visuales que conectan, comunican y perduran.
          </p>
          <p>
            Con mas de 10 anos de trayectoria, hemos acompanado a marcas lideres en la creacion de soluciones visuales de alto impacto en todo el pais.
          </p>
        </div>

        <div class="story-stats">
          {
            stats.map(({ icon: Icon, value, label }) => (
              <article>
                <Icon size={25} strokeWidth={1.75} aria-hidden="true" />
                <strong>{value}</strong>
                <span>{label}</span>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-hero-section {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 2rem 9rem, rgba(5, 49, 60, 0.1) 0 1px, transparent 1px),
      var(--color-brand-white);
    background-size: 0.8rem 0.8rem;
    padding-top: 5rem;
  }

  .about-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 44%) minmax(0, 56%);
    min-height: 33rem;
    align-items: stretch;
  }

  .about-copy {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 4.2rem 0 4.2rem 7rem;
  }

  .about-copy-inner {
    position: relative;
    width: min(34rem, 100%);
    padding-right: 2.8rem;
  }

  .about-copy-line {
    position: absolute;
    left: -2rem;
    top: 4.3rem;
    width: 0.12rem;
    height: 6.8rem;
    border-radius: 999px;
    background: var(--color-brand-orange);
  }

  .about-eyebrow {
    font-family: var(--font-title);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-brand-orange);
  }

  .about-copy h1 {
    margin-top: 0.9rem;
    font-family: var(--font-title);
    font-size: clamp(1.5rem, 2.15vw, 2.6rem);
    font-weight: 800;
    font-style: italic;
    line-height: 1.08;
    color: var(--color-brand-black);
  }

  .about-copy h1 span {
    color: var(--color-brand-orange);
  }

  .about-summary {
    margin-top: 1.1rem;
    max-width: 30rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.66);
  }

  .about-visual {
    position: relative;
    min-height: 100%;
    margin-left: -5rem;
    overflow: hidden;
    background: transparent;
  }

  .story-layer {
    position: absolute;
    inset: 0;
  }

  .story-layer-gray {
    inset: 0 -0.2rem 0 0;
    clip-path: polygon(clamp(13rem, 16vw, 19.8rem) 0, 100% 0, 100% 100%, 0 100%);
    background: linear-gradient(180deg, rgba(240, 241, 240, 0.98), rgba(201, 201, 201, 0.84));
  }

  .story-layer-silver {
    inset: 0 0 0 0.15rem;
    clip-path: polygon(clamp(13.8rem, 16.8vw, 20.75rem) 0, 100% 0, 100% 100%, 0.85rem 100%);
    background:
      radial-gradient(circle at 50% 18%, rgba(255, 255, 255, 0.95), rgba(130, 130, 130, 0.46) 36%, rgba(50, 50, 50, 0.64) 100%),
      linear-gradient(90deg, rgba(54, 54, 54, 0.86), rgba(236, 236, 236, 0.72), rgba(47, 47, 47, 0.86));
  }

  .story-layer-orange {
    inset: 0 0 0 0.5rem;
    clip-path: polygon(clamp(14.6rem, 17.6vw, 21.45rem) 0, 100% 0, 100% 100%, 1.55rem 100%);
    background: linear-gradient(90deg, rgba(191, 75, 0, 0.78), var(--color-brand-orange), rgba(191, 75, 0, 0.78));
    box-shadow:
      0 0 16px rgba(249, 146, 40, 0.7),
      0 0 38px rgba(249, 146, 40, 0.42);
  }

  .story-layer-black {
    inset: 0 0 0 0.9rem;
    clip-path: polygon(clamp(15.5rem, 18.4vw, 22.35rem) 0, 100% 0, 100% 100%, 2.45rem 100%);
    background:
      radial-gradient(circle at 82% 18%, rgba(255, 255, 255, 0.08), transparent 18rem),
      linear-gradient(90deg, rgba(0, 0, 0, 0.96) 0%, rgba(10, 10, 10, 0.98) 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  .story-panel {
    position: absolute;
    inset: 0 clamp(3rem, 5vw, 7rem) 0 0;
    z-index: 2;
    display: grid;
    align-content: center;
    gap: 1.35rem;
    padding: clamp(3rem, 4vw, 4.1rem) clamp(2.2rem, 3.5vw, 4rem) 2.7rem clamp(11rem, 17vw, 19rem);
    color: var(--color-brand-white);
  }

  .story-copy {
    max-width: 42rem;
  }

  .story-copy h2 {
    font-family: var(--font-title);
    font-size: 1.12rem;
    font-weight: 800;
  }

  .story-copy > div {
    width: 3.5rem;
    height: 0.14rem;
    margin: 0.55rem 0 0.75rem;
    border-radius: 999px;
    background: var(--color-brand-orange);
    box-shadow: 0 0 12px rgba(249, 146, 40, 0.5);
  }

  .story-copy p {
    max-width: 39rem;
    font-size: 0.66rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.68);
  }

  .story-copy p + p {
    margin-top: 0.65rem;
  }

  .story-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: min(30rem, 100%);
  }

  .story-stats article {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.28rem;
    text-align: center;
    padding: 0 0.65rem;
  }

  .story-stats article:not(:first-child)::before {
    content: "";
    position: absolute;
    left: 0;
    top: 7%;
    width: 1px;
    height: 86%;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.22), transparent);
  }

  .story-stats svg {
    color: var(--color-brand-orange);
  }

  .story-stats strong {
    font-family: var(--font-title);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-brand-white);
  }

  .story-stats span {
    max-width: 6.5rem;
    font-size: 0.54rem;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.72);
  }

  @media (max-width: 1279px) {
    .about-hero-grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .about-copy {
      justify-content: flex-start;
      padding: 4rem 3rem 2.4rem;
    }

    .about-copy-inner {
      max-width: 38rem;
      padding-right: 0;
    }

    .about-visual {
      margin-left: 0;
      min-height: 29rem;
      clip-path: none;
    }

    .story-panel {
      inset: 0 3rem 0 0.9rem;
      width: auto;
      max-width: none;
      padding: 3.4rem 2.4rem 2.5rem 13.5rem;
    }
  }

  @media (max-width: 1535px) and (min-width: 1280px) {
    .about-hero-grid {
      grid-template-columns: minmax(0, 42%) minmax(0, 58%);
    }

    .about-copy {
      padding-left: 5.2rem;
    }

    .about-copy h1 {
      font-size: clamp(1.5rem, 2.15vw, 2.6rem);
    }

    .story-panel {
      gap: 1.05rem;
      padding-left: clamp(13rem, 18vw, 16rem);
      padding-right: 2.4rem;
    }

    .story-copy p {
      max-width: 35rem;
      font-size: 0.58rem;
      line-height: 1.45;
    }

    .story-stats {
      width: min(25rem, 100%);
    }

    .story-stats article {
      padding: 0 0.45rem;
    }

    .story-stats strong {
      font-size: 1rem;
    }

    .story-stats span {
      font-size: 0.5rem;
    }
  }

  @media (max-width: 640px) {
    .about-hero-section {
      padding-top: 4.8rem;
    }

    .about-copy {
      padding: 2.4rem 1.25rem 1.6rem;
    }

    .about-copy h1 {
      font-size: 2rem;
    }

    .about-copy-line {
      display: none;
    }

    .about-visual {
      min-height: auto;
      overflow: visible;
    }

    .story-layer {
      display: none;
    }

    .story-panel {
      position: relative;
      inset: auto;
      width: auto;
      max-width: none;
      min-height: auto;
      border: 0;
      padding: 1.6rem 1.25rem;
      clip-path: none;
      background: linear-gradient(90deg, rgba(0, 0, 0, 0.96) 0%, rgba(10, 10, 10, 0.98) 100%);
    }

    .story-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .story-stats article::before {
      display: none;
    }
  }
</style>
