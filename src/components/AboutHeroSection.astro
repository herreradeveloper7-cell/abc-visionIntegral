---
import { Award, BadgeCheck, Building2, UsersRound } from "lucide-astro";

const stats = [
  {
    icon: Award,
    value: "+10",
    label: "Anos de experiencia",
  },
  {
    icon: Building2,
    value: "+450",
    label: "Proyectos exitosos",
  },
  {
    icon: UsersRound,
    value: "+120",
    label: "Marcas que confian",
  },
  {
    icon: BadgeCheck,
    value: "100%",
    label: "Comprometidos con la calidad",
  },
];
---

<section class="about-hero-section">
  <div class="about-copy">
    <div class="about-copy-line" aria-hidden="true"></div>

    <p class="about-eyebrow">Somos ABC Vision Integral</p>
    <h1>
      Una marca que disena, produce e instala con
      <span>precision.</span>
    </h1>
    <p class="about-summary">
      Combinamos creatividad, tecnologia y precision para producir piezas visuales que hacen visible el valor de tu marca.
    </p>
  </div>

  <div class="story-stack">
    <div class="story-layer story-layer-gray"></div>
    <div class="story-layer story-layer-silver"></div>
    <div class="story-layer story-layer-orange"></div>
    <div class="story-panel">
      <div class="story-copy">
        <h2>Nuestra historia</h2>
        <div aria-hidden="true"></div>
        <p>
          ABC Vision Integral nace de la pasion por transformar ideas en experiencias visuales que conectan, comunican y perduran.
        </p>
        <p>
          Con mas de 10 anos de trayectoria, hemos acompanado a marcas lideres en la creacion de soluciones visuales de alto impacto en todo el pais.
        </p>
      </div>

      <div class="story-stats">
        {
          stats.map(({ icon: Icon, value, label }) => (
            <article>
              <Icon size={28} strokeWidth={1.75} aria-hidden="true" />
              <strong>{value}</strong>
              <span>{label}</span>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about-hero-section {
    position: relative;
    display: grid;
    grid-template-columns: minmax(20rem, 0.95fr) minmax(24rem, 1.05fr);
    align-items: center;
    min-height: 34rem;
    gap: 2.2rem;
  }

  .about-copy {
    position: relative;
    z-index: 2;
    max-width: 39rem;
    padding-left: 0.2rem;
  }

  .about-copy-line {
    position: absolute;
    left: -2.7rem;
    top: 8.1rem;
    width: 0.12rem;
    height: 7.3rem;
    border-radius: 999px;
    background: var(--color-brand-orange);
  }

  .about-eyebrow {
    font-family: var(--font-title);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-brand-orange);
  }

  .about-copy h1 {
    margin-top: 1rem;
    font-family: var(--font-title);
    font-size: clamp(2.3rem, 3.55vw, 4.25rem);
    font-weight: 800;
    font-style: italic;
    line-height: 1.08;
    color: var(--color-brand-black);
  }

  .about-copy h1 span {
    color: var(--color-brand-orange);
  }

  .about-summary {
    margin-top: 1.3rem;
    max-width: 34rem;
    font-size: 0.96rem;
    line-height: 1.62;
    color: rgba(0, 0, 0, 0.66);
  }

  .story-stack {
    position: relative;
    min-height: 26rem;
  }

  .story-layer,
  .story-panel {
    position: absolute;
    inset: 0;
    clip-path: polygon(7.2rem 0, 100% 0, 100% 100%, 0 100%);
  }

  .story-layer-gray {
    inset: 0.35rem -0.35rem -0.35rem 0.15rem;
    background: linear-gradient(180deg, rgba(240, 241, 240, 0.98), rgba(201, 201, 201, 0.84));
  }

  .story-layer-silver {
    inset: 0.75rem 0.15rem 0.25rem 0.55rem;
    background:
      radial-gradient(circle at 50% 18%, rgba(255, 255, 255, 0.95), rgba(130, 130, 130, 0.46) 36%, rgba(50, 50, 50, 0.64) 100%),
      linear-gradient(90deg, rgba(54, 54, 54, 0.86), rgba(236, 236, 236, 0.72), rgba(47, 47, 47, 0.86));
  }

  .story-layer-orange {
    inset: 1.1rem 0.55rem 0.65rem 0.95rem;
    background: linear-gradient(90deg, rgba(191, 75, 0, 0.78), var(--color-brand-orange), rgba(191, 75, 0, 0.78));
    box-shadow:
      0 0 16px rgba(249, 146, 40, 0.7),
      0 0 38px rgba(249, 146, 40, 0.42);
  }

  .story-panel {
    inset: 1.45rem 0.95rem 1rem 1.35rem;
    display: grid;
    align-content: center;
    gap: 1.9rem;
    padding: 3rem 2.2rem 2.2rem 8.5rem;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.96) 0%, rgba(10, 10, 10, 0.98) 100%);
    color: var(--color-brand-white);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  .story-copy h2 {
    font-family: var(--font-title);
    font-size: 1.35rem;
    font-weight: 800;
  }

  .story-copy > div {
    width: 3.5rem;
    height: 0.14rem;
    margin: 0.65rem 0 1rem;
    border-radius: 999px;
    background: var(--color-brand-orange);
    box-shadow: 0 0 12px rgba(249, 146, 40, 0.5);
  }

  .story-copy p {
    max-width: 23rem;
    font-size: 0.78rem;
    line-height: 1.58;
    color: rgba(255, 255, 255, 0.68);
  }

  .story-copy p + p {
    margin-top: 1rem;
  }

  .story-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .story-stats article {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    text-align: center;
    padding: 0 0.8rem;
  }

  .story-stats article:not(:first-child)::before {
    content: "";
    position: absolute;
    left: 0;
    top: 7%;
    width: 1px;
    height: 86%;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.22), transparent);
  }

  .story-stats svg {
    color: var(--color-brand-orange);
  }

  .story-stats strong {
    font-family: var(--font-title);
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-brand-white);
  }

  .story-stats span {
    max-width: 6.5rem;
    font-size: 0.62rem;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.72);
  }

  @media (max-width: 1279px) {
    .about-hero-section {
      grid-template-columns: 1fr;
    }

    .story-stack {
      min-height: 25rem;
    }
  }

  @media (max-width: 640px) {
    .about-hero-section {
      min-height: auto;
    }

    .about-copy-line {
      display: none;
    }

    .story-layer,
    .story-panel {
      clip-path: none;
    }

    .story-panel {
      position: relative;
      inset: auto;
      padding: 2rem 1.2rem;
    }

    .story-layer {
      display: none;
    }

    .story-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .story-stats article::before {
      display: none;
    }
  }
</style>
