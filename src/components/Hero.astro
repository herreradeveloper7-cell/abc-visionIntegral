---
import { ArrowRight, Box, Cpu, Cog, Crosshair, MapPin, ScanLine, Shirt, Sofa, Target, Truck } from "lucide-astro";

interface Props {
  eyebrow?: string;
  title?: string;
  highlightedTitle?: string;
  description?: string;
  image?: string;
  laptopImage?: string;
  imageAlt?: string;
  showActions?: boolean;
  showPanels?: boolean;
  compact?: boolean;
  primaryActionLabel?: string;
  primaryActionHref?: string;
  secondaryActionLabel?: string;
  secondaryActionHref?: string;
}

const {
  eyebrow = "Comunicacion visual que construye marcas",
  title = "Potenciamos tu imagen comercial con soluciones visuales de",
  highlightedTitle = "alto impacto",
  description = "Combinamos creatividad, tecnologia y precision para producir piezas visuales que hacen visible el valor de tu marca.",
  image = "/images/hero-vision-integral.webp",
  laptopImage = "/images/hero-vision-integral-laptop.png",
  imageAlt = "Soluciones visuales de ABC Vision Integral",
  showActions = true,
  showPanels = true,
  compact = false,
  primaryActionLabel = "Conoce nuestros servicios",
  primaryActionHref = "/servicios",
  secondaryActionLabel = "Ver proyectos",
  secondaryActionHref = "/proyectos",
} = Astro.props;

const features = [
  {
    icon: Cog,
    title: "Produccion propia",
    text: "Control total de calidad y tiempos de entrega.",
  },
  {
    icon: Cpu,
    title: "Tecnologia de ultima generacion",
    text: "Equipos de alto rendimiento para resultados superiores.",
  },
  {
    icon: Truck,
    title: "Instalacion y logistica",
    text: "Cobertura nacional con instalacion profesional.",
  },
  {
    icon: Target,
    title: "Impacto visual",
    text: "Creamos experiencias visuales que conectan y posicionan.",
  },
];

const services = [
  { icon: ScanLine, label: "Impresion UV" },
  { icon: Crosshair, label: "Corte laser" },
  { icon: Box, label: "Gran formato" },
  { icon: Cog, label: "Branding" },
  { icon: MapPin, label: "Senalizacion" },
  { icon: Sofa, label: "Stands" },
  { icon: Truck, label: "Mobiliario" },
  { icon: Shirt, label: "Merchandising" },
];
---

<section class:list={["hero-section relative overflow-hidden bg-brand-white", showPanels ? "pb-0" : compact ? "pb-10" : "pb-16"]}>
  <div class:list={["hero-grid", showPanels ? "min-h-[46rem]" : compact ? "min-h-120 lg:min-h-132" : "min-h-[42rem]"]}>
    <div class="hero-copy relative z-10 flex justify-start px-8 md:px-16 lg:pl-24 lg:pr-8">
      <div class="hero-copy-inner relative md:pl-10">
        <div class="absolute -left-8 top-24 hidden h-32 w-0.5 bg-brand-orange md:block rounded-2xl"></div>

        <p class="mb-4 font-title text-xs font-extrabold uppercase tracking-wide text-brand-orange md:text-sm">
          {eyebrow}
        </p>

        <h1 class="font-title text-2xl font-extrabold italic leading-[1.08] text-brand-black md:text-2xl xl:text-[2.6rem]">
          {title}
          <span class="text-brand-orange"> {highlightedTitle}</span>
        </h1>

        <p class="mt-5 max-w-lg text-base leading-7 text-brand-black/65">
          {description}
        </p>

        {
          showActions && (
            <div class="hero-actions mt-7 flex gap-4">
              <a href={primaryActionHref} class="hero-button hero-button-orange">
                <span>{primaryActionLabel}</span>
                <ArrowRight size={16} strokeWidth={2.5} aria-hidden="true" />
              </a>

              <a href={secondaryActionHref} class="hero-button hero-button-dark">
                <span>{secondaryActionLabel}</span>
                <ArrowRight size={16} strokeWidth={2.5} aria-hidden="true" />
              </a>
            </div>
          )
        }
      </div>
    </div>

    <div class="hero-visual relative overflow-hidden">
      <picture class="absolute inset-0 block h-full w-full">
        <source
          media="(min-width: 1024px) and (max-width: 1535px)"
          srcset={laptopImage}
        />
        <img
          src={image}
          alt={imageAlt}
          class="h-full w-full object-cover object-left"
        />
      </picture>
    </div>

    <img
      class="hero-divider"
      src="/images/hero-diagonal-divider.svg"
      alt=""
      aria-hidden="true"
    />
  </div>
</section>

{
  showPanels && (
    <div class="feature-strip relative z-20 ml-auto mr-0 w-[92vw] pl-4 pr-0">
      <div class="feature-base">
        <div class="feature-panel">
          {features.map(({ icon: Icon, title, text }) => (
            <article class="feature-item">
              <div class="feature-icon">
                <Icon size={34} strokeWidth={1.8} aria-hidden="true" />
              </div>
              <div>
                <h2>{title}</h2>
                <p>{text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  )
}

<style>
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 55%) minmax(0, 45%);
    align-items: stretch;
    overflow: hidden;
    max-width: 100%;
  }

  .hero-section {
    isolation: isolate;
  }

  .hero-visual {
    min-height: 100%;
    min-width: 0;
    background: var(--color-brand-black);
  }

  .hero-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(55% - 11.05rem);
    z-index: 15;
    display: block;
    width: 28rem;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
  }

  @media (max-width: 1535px) and (min-width: 1024px) {
    .hero-divider {
      left: calc(55% - 9.5rem);
      width: 24rem;
    }
  }

  .hero-copy {
    background:
      radial-gradient(circle at 2rem 9rem, rgba(5, 49, 60, 0.1) 0 1px, transparent 1px),
      var(--color-brand-white);
    background-size: 0.8rem 0.8rem;
    align-items: flex-start;
    padding-top: 10rem;
    padding-bottom: 2.5rem;
  }

  .hero-copy-inner {
    width: 100%;
    max-width: 32rem;
  }

  .hero-copy h1 {
    font-size: clamp(2rem, 2.35vw, 2.6rem);
  }

  .hero-button {
    position: relative;
    display: inline-flex;
    min-height: 3rem;
    width: max-content;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 1.15rem;
    padding: 0 1.35rem;
    border-radius: 0.35rem;
    font-family: var(--font-title);
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--color-brand-white);
    white-space: nowrap;
    overflow: hidden;
    transition: background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease, filter 180ms ease;
  }

  .hero-button span {
    position: relative;
    z-index: 1;
    display: inline-block;
    white-space: nowrap;
  }

  .hero-button svg {
    position: relative;
    z-index: 1;
  }

  .hero-button:hover {
    filter: brightness(1.08);
    transform: translateY(-2px) scale(1.02);
  }

  .hero-button::after {
    content: "";
    position: absolute;
    top: -35%;
    left: -35%;
    width: 28%;
    height: 170%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: translateX(-120%) skewX(-22deg);
    transition: transform 520ms ease;
  }

  .hero-button:hover::after {
    transform: translateX(520%) skewX(-22deg);
  }

  .hero-button-orange {
    background: linear-gradient(90deg, #c85a00 0%, #e87912 45%, var(--color-brand-orange) 100%);
    box-shadow: 0 12px 28px rgba(249, 146, 40, 0.24);
  }

  .hero-button-orange:hover {
    box-shadow:
      0 0 18px rgba(249, 146, 40, 0.58),
      0 18px 34px rgba(249, 146, 40, 0.34);
  }

  .hero-button-dark {
    background: var(--color-brand-black);
  }

  .hero-button-dark:hover {
    background: var(--color-brand-dark);
    box-shadow:
      0 0 16px rgba(249, 146, 40, 0.32),
      0 16px 30px rgba(0, 0, 0, 0.3);
  }


  .service-item {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.38rem;
    padding: 0.65rem 0.26rem;
    color: rgba(255, 255, 255, 0.8);
    text-align: center;
  }

  .service-item + .service-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12%;
    width: 1px;
    height: 76%;
    background: rgba(255, 255, 255, 0.2);
    transform: skewX(-24deg);
  }

  .service-item span {
    font-family: var(--font-title);
    font-size: 0.5rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .feature-strip {
    margin-top: 0;
  }

  .feature-base {
    position: relative;
    padding: 1.5rem 1.7rem 0.35rem;
    background: #050505;
    clip-path: polygon(4rem 0, 100% 0, 100% 100%, 0 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.14),
      0 24px 50px rgba(0, 0, 0, 0.28);
  }

  .feature-panel {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    min-height: 6.5rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: linear-gradient(180deg, rgba(24, 24, 24, 0.96), rgba(8, 8, 8, 0.98));
    clip-path: polygon(3rem 0, 100% 0, calc(100% - 2.4rem) 100%, 0 100%);
    overflow: hidden;
  }

  .feature-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.15rem;
    padding: 1rem 4.2rem;
    color: var(--color-brand-white);
  }

  .feature-item + .feature-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 14%;
    width: 1px;
    height: 72%;
    background: rgba(255, 255, 255, 0.2);
    transform: skewX(-24deg);
  }

  .feature-icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    flex: 0 0 auto;
    place-items: center;
    color: var(--color-brand-orange);
  }

  .feature-item h2 {
    font-family: var(--font-title);
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .feature-item p {
    margin-top: 0.3rem;
    max-width: 13rem;
    font-size: 0.72rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.68);
  }

  @media (max-width: 1023px) {
    .hero-section {
      padding-top: 5.4rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero-visual {
      min-height: clamp(18rem, 48vw, 25rem);
    }

    .hero-divider {
      display: none;
    }

    .hero-copy {
      transform: none;
      justify-content: flex-start;
      padding: 4.2rem clamp(1.5rem, 6vw, 4rem) 2.4rem;
    }

    .hero-copy > div {
      max-width: 38rem;
      padding-left: 0;
    }

    .feature-strip {
      width: 100%;
      margin-top: 0;
      padding-left: 0;
      padding-right: 0;
    }

    .feature-base {
      padding: 0;
      box-shadow:
        inset 0 0 0 1px rgba(255, 255, 255, 0.12),
        0 -10px 30px rgba(0, 0, 0, 0.2);
    }

    .feature-base,
    .feature-panel {
      clip-path: none;
    }

    .feature-panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-left: 0;
      border-right: 0;
    }

    .feature-item {
      padding: 1.1rem 1.4rem;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding-top: 4.9rem;
    }

    .hero-copy {
      padding: 2.4rem 1.2rem 1.8rem;
    }

    .hero-copy h1 {
      font-size: 2rem;
    }

    .hero-copy p {
      font-size: 0.92rem;
      line-height: 1.6;
    }

    .hero-actions {
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .hero-button {
      width: 100%;
      min-height: 2.85rem;
      justify-content: center;
    }

    .feature-panel {
      grid-template-columns: 1fr;
    }

    .feature-strip {
      margin-top: 0;
    }

    .feature-item + .feature-item::before {
      top: 0;
      width: 100%;
      height: 1px;
      transform: none;
    }

    .feature-item {
      min-height: 5.7rem;
      padding: 1rem 1.2rem;
    }

    .feature-icon {
      width: 2.65rem;
      height: 2.65rem;
    }
  }
</style>
