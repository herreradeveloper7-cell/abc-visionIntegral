---
import { ArrowRight, Box, Cpu, Cog, Crosshair, MapPin, ScanLine, Shirt, Sofa, Target, Truck } from "lucide-astro";

const features = [
  {
    icon: Cog,
    title: "Produccion propia",
    text: "Control total de calidad y tiempos de entrega.",
  },
  {
    icon: Cpu,
    title: "Tecnologia de ultima generacion",
    text: "Equipos de alto rendimiento para resultados superiores.",
  },
  {
    icon: Truck,
    title: "Instalacion y logistica",
    text: "Cobertura nacional con instalacion profesional.",
  },
  {
    icon: Target,
    title: "Impacto visual",
    text: "Creamos experiencias visuales que conectan y posicionan.",
  },
];

const services = [
  { icon: ScanLine, label: "Impresion UV" },
  { icon: Crosshair, label: "Corte laser" },
  { icon: Box, label: "Gran formato" },
  { icon: Cog, label: "Branding" },
  { icon: MapPin, label: "Senalizacion" },
  { icon: Sofa, label: "Stands" },
  { icon: Truck, label: "Mobiliario" },
  { icon: Shirt, label: "Merchandising" },
];
---

<section class="hero-section relative overflow-hidden bg-brand-white pb-16 pt-20">
  <div class="hero-grid min-h-148 lg:min-h-160">
    <div class="hero-copy relative z-10 flex -translate-y-6 items-center justify-end px-8 py-10 pt-16 md:px-16 md:pt-0 lg:pl-24 lg:pr-0">
      <div class="relative max-w-xl md:pl-10">
        <div class="absolute -left-8 top-24 hidden h-32 w-0.5 bg-brand-orange md:block rounded-2xl"></div>

        <p class="mb-4 font-title text-xs font-extrabold uppercase tracking-wide text-brand-orange md:text-sm">
          Comunicacion visual que construye marcas
        </p>

        <h1 class="font-title text-2xl font-extrabold italic leading-[1.08] text-brand-black md:text-2xl xl:text-[2.6rem]">
          Potenciamos tu imagen comercial con soluciones visuales de
          <span class="text-brand-orange">alto impacto</span>
        </h1>

        <p class="mt-5 max-w-lg text-base leading-7 text-brand-black/65">
          Combinamos creatividad, tecnologia y precision para producir piezas visuales que hacen visible el valor de tu marca.
        </p>

        <div class="mt-7 flex flex-wrap gap-5">
          <a href="/servicios" class="hero-button hero-button-orange">
            <span>Conoce nuestros servicios</span>
            <ArrowRight size={16} strokeWidth={2.5} aria-hidden="true" />
          </a>

          <a href="/proyectos" class="hero-button hero-button-dark">
            <span>Ver proyectos</span>
            <ArrowRight size={16} strokeWidth={2.5} aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>

    <div class="hero-visual relative overflow-hidden">
      <img
        src="/images/imagen-hero.webp"
        alt="Soluciones visuales de ABC Vision Integral"
        class="absolute inset-0 h-full w-full scale-110 object-cover object-[100%_center]"
      />
    </div>
  </div>

  <div class="service-strip relative z-30 -mt-45 ml-auto mr-0 w-[50vw] pl-4 pr-0">
    <div class="service-panel relative -top-2 z-20 w-full px-10 py-2">
      {
        services.map(({ icon: Icon, label }) => (
          <article class="service-item">
            <Icon size={22} strokeWidth={1.7} aria-hidden="true" />
            <span>{label}</span>
          </article>
        ))
      }
    </div>
  </div>

  <div class="feature-strip relative z-20 ml-auto mr-0 -mt-2 w-[92vw] pl-4 pr-0">
    <div class="feature-base">
      <div class="feature-panel">
        {
          features.map(({ icon: Icon, title, text }) => (
            <article class="feature-item">
              <div class="feature-icon">
                <Icon size={34} strokeWidth={1.8} aria-hidden="true" />
              </div>
              <div>
                <h2>{title}</h2>
                <p>{text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 44%) minmax(0, 56%);
    align-items: stretch;
    overflow: hidden;
  }

  .hero-visual {
    margin-left: -5rem;
    min-height: 100%;
    background: var(--color-brand-black);
    clip-path: polygon(30rem 0, 100% 0, 100% 100%, 0rem 100%);
  }

  .hero-copy {
    background:
      radial-gradient(circle at 2rem 9rem, rgba(5, 49, 60, 0.1) 0 1px, transparent 1px),
      var(--color-brand-white);
    background-size: 0.8rem 0.8rem;
  }

  .hero-button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 0 1.55rem;
    border-radius: 0.35rem;
    font-family: var(--font-title);
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--color-brand-white);
    transition: background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .hero-button:hover {
    transform: translateY(-2px);
  }

  .hero-button-orange {
    background: linear-gradient(90deg, #c85a00 0%, #e87912 45%, var(--color-brand-orange) 100%);
    box-shadow: 0 12px 28px rgba(249, 146, 40, 0.24);
  }

  .hero-button-orange:hover {
    box-shadow: 0 16px 34px rgba(249, 146, 40, 0.34);
  }

  .hero-button-dark {
    background: var(--color-brand-black);
  }

  .hero-button-dark:hover {
    background: var(--color-brand-dark);
  }

  .service-panel {
    position: relative;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 7.8rem));
    justify-content: end;
    min-height: 3.9rem;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: rgba(4, 4, 4, 0.82);
    clip-path: polygon(2.4rem 0, 100% 0, 100% 100%, 0 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 18px 34px rgba(0, 0, 0, 0.26);
    backdrop-filter: blur(4px);
  }

  .service-item {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.38rem;
    padding: 0.65rem 0.26rem;
    color: rgba(255, 255, 255, 0.8);
    text-align: center;
  }

  .service-item + .service-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12%;
    width: 1px;
    height: 76%;
    background: rgba(255, 255, 255, 0.2);
    transform: skewX(-24deg);
  }

  .service-item span {
    font-family: var(--font-title);
    font-size: 0.5rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .feature-base {
    position: relative;
    padding: 1.5rem 1.7rem 0.35rem;
    background: #050505;
    clip-path: polygon(4rem 0, 100% 0, 100% 100%, 0 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.14),
      0 24px 50px rgba(0, 0, 0, 0.28);
  }

  .feature-panel {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    min-height: 6.5rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: linear-gradient(180deg, rgba(24, 24, 24, 0.96), rgba(8, 8, 8, 0.98));
    clip-path: polygon(3rem 0, 100% 0, calc(100% - 2.4rem) 100%, 0 100%);
    overflow: hidden;
  }

  .feature-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.15rem;
    padding: 1rem 4.2rem;
    color: var(--color-brand-white);
  }

  .feature-item + .feature-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 14%;
    width: 1px;
    height: 72%;
    background: rgba(255, 255, 255, 0.2);
    transform: skewX(-24deg);
  }

  .feature-icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    flex: 0 0 auto;
    place-items: center;
    color: var(--color-brand-orange);
  }

  .feature-item h2 {
    font-family: var(--font-title);
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .feature-item p {
    margin-top: 0.3rem;
    max-width: 13rem;
    font-size: 0.72rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.68);
  }

  @media (max-width: 1023px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      margin-left: 0;
      min-height: 22rem;
      clip-path: none;
    }

    .feature-strip {
      margin-top: 1.5rem;
    }

    .service-strip {
      margin-top: 1.5rem;
    }

    .service-panel {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      clip-path: none;
    }

    .feature-base,
    .feature-panel {
      clip-path: none;
    }

    .feature-panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .service-panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feature-panel {
      grid-template-columns: 1fr;
    }

    .feature-item + .feature-item::before {
      top: 0;
      width: 100%;
      height: 1px;
      transform: none;
    }
  }
</style>
