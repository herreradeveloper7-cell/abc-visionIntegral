---
import { ArrowRight, Facebook, Instagram, Linkedin, Youtube } from "lucide-astro";

const services = [
  "Impresion UV",
  "Corte laser",
  "Gran formato",
  "Branding",
  "Senalizacion",
  "Stands",
  "Mobiliario",
  "Merchandising",
];

const quickLinks = [
  { label: "Inicio", href: "/" },
  { label: "Servicios", href: "/servicios" },
  { label: "Proyectos", href: "/proyectos" },
  { label: "Nosotros", href: "/nosotros" },
  { label: "Contacto", href: "/contacto" },
];

const socials = [
  { label: "Instagram", href: "https://www.instagram.com/", icon: Instagram },
  { label: "LinkedIn", href: "https://www.linkedin.com/", icon: Linkedin },
  { label: "Facebook", href: "https://www.facebook.com/", icon: Facebook },
  { label: "YouTube", href: "https://www.youtube.com/", icon: Youtube },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-main">
      <div class="footer-brand">
        <img src="/images/logo-abc.png" alt="ABC Vision Integral" />
        <p>Soluciones visuales integrales que conectan tu marca con el mundo.</p>
      </div>

      <nav class="footer-services" aria-label="Servicios">
        <h2>Servicios</h2>
        <div>
          {
            services.map((service) => (
              <a href="/servicios">{service}</a>
            ))
          }
        </div>
      </nav>

      <nav class="footer-links" aria-label="Enlaces rapidos">
        <h2>Enlaces rapidos</h2>
        {
          quickLinks.map(({ label, href }) => (
            <a href={href}>{label}</a>
          ))
        }
      </nav>

      <div class="footer-social">
        <h2>Siguenos</h2>
        <div>
          {
            socials.map(({ label, href, icon: Icon }) => (
              <a href={href} target="_blank" rel="noreferrer" aria-label={label}>
                <Icon size={15} strokeWidth={2} aria-hidden="true" />
              </a>
            ))
          }
        </div>
      </div>

      <div class="footer-cta">
        <h2>Listo para impulsar tu marca?</h2>
        <p>Cuentanos tu proyecto y recibe asesoria personalizada.</p>
        <a href="https://wa.me/573001234567" target="_blank" rel="noreferrer">
          <span>Escribenos por WhatsApp</span>
          <ArrowRight size={16} strokeWidth={2.5} aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© 2025 ABC Vision Integral. Todos los derechos reservados.</p>
      <div>
        <a href="/politica-de-privacidad">Politica de privacidad</a>
        <span aria-hidden="true"></span>
        <a href="/terminos-y-condiciones">Terminos y condiciones</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--color-brand-black);
    color: var(--color-brand-white);
  }

  .site-footer::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 0%, rgba(255, 255, 255, 0.08), transparent 24rem),
      linear-gradient(180deg, rgba(25, 25, 25, 0.98), #030303 100%);
    pointer-events: none;
  }

  .site-footer::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0.16rem;
    background: linear-gradient(90deg, transparent 0%, rgba(249, 146, 40, 0.55) 12%, var(--color-brand-orange) 50%, rgba(249, 146, 40, 0.55) 88%, transparent 100%);
    box-shadow: 0 0 18px rgba(249, 146, 40, 0.52);
  }

  .footer-inner {
    position: relative;
    z-index: 1;
    width: min(100%, 112rem);
    margin: 0 auto;
    padding: 2.35rem 4.5rem 1.45rem;
    border-top: 0;
    border-radius: 0 0 1.25rem 1.25rem;
    background: transparent;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(15rem, 1.25fr) minmax(15rem, 1.15fr) minmax(8rem, 0.72fr) minmax(7rem, 0.62fr) minmax(19rem, 1.25fr);
    gap: 2.2rem;
    align-items: start;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-brand img {
    width: 9.6rem;
    height: auto;
    flex: 0 0 auto;
  }

  .footer-brand p,
  .footer-cta p,
  .footer-bottom,
  .footer-main a {
    color: rgba(255, 255, 255, 0.64);
  }

  .footer-brand p {
    max-width: 15rem;
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .footer-main h2 {
    margin-bottom: 0.82rem;
    font-family: var(--font-title);
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .footer-services div {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2rem;
    row-gap: 0.55rem;
  }

  .footer-links,
  .footer-services,
  .footer-social {
    min-width: 0;
  }

  .footer-links a,
  .footer-services a {
    display: block;
    width: max-content;
    max-width: 100%;
    font-size: 0.7rem;
    line-height: 1.3;
    transition: color 180ms ease, transform 180ms ease;
  }

  .footer-links a + a {
    margin-top: 0.55rem;
  }

  .footer-links a:hover,
  .footer-services a:hover,
  .footer-bottom a:hover {
    color: var(--color-brand-orange);
  }

  .footer-links a:hover,
  .footer-services a:hover {
    transform: translateX(0.18rem);
  }

  .footer-social div {
    display: flex;
    gap: 0.55rem;
  }

  .footer-social a {
    display: grid;
    width: 1.9rem;
    height: 1.9rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    transition: border-color 180ms ease, color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .footer-social a:hover {
    border-color: rgba(249, 146, 40, 0.75);
    color: var(--color-brand-orange);
    box-shadow: 0 0 14px rgba(249, 146, 40, 0.36);
    transform: translateY(-0.15rem);
  }

  .footer-cta h2 {
    margin-bottom: 0.55rem;
    font-size: 1.05rem;
  }

  .footer-cta p {
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .footer-cta a {
    position: relative;
    display: inline-flex;
    min-height: 2.85rem;
    align-items: center;
    gap: 2rem;
    overflow: hidden;
    margin-top: 1.05rem;
    border-radius: 0.28rem;
    background: linear-gradient(90deg, #f36d07 0%, var(--color-brand-orange) 100%);
    padding: 0 1.45rem;
    font-family: var(--font-title);
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--color-brand-white);
    transition: box-shadow 180ms ease, filter 180ms ease, transform 180ms ease;
  }

  .footer-cta a::after {
    content: "";
    position: absolute;
    top: -35%;
    left: -35%;
    width: 28%;
    height: 170%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: translateX(-120%) skewX(-22deg);
    transition: transform 520ms ease;
  }

  .footer-cta a > * {
    position: relative;
    z-index: 1;
  }

  .footer-cta a:hover {
    filter: brightness(1.08);
    box-shadow:
      0 0 18px rgba(249, 146, 40, 0.58),
      0 18px 34px rgba(249, 146, 40, 0.26);
    transform: translateY(-0.12rem);
  }

  .footer-cta a:hover::after {
    transform: translateX(520%) skewX(-22deg);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 1.1rem;
    font-size: 0.68rem;
  }

  .footer-bottom div {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .footer-bottom span {
    width: 1px;
    height: 0.85rem;
    background: rgba(255, 255, 255, 0.2);
  }

  .footer-bottom a {
    transition: color 180ms ease;
  }

  @media (max-width: 1279px) {
    .footer-inner {
      padding: 2.2rem 2rem 1.4rem;
    }

    .footer-main {
      grid-template-columns: 1.2fr 1fr 0.75fr;
    }
  }

  @media (max-width: 767px) {
    .footer-inner {
      padding: 2rem 1.25rem 1.35rem;
      border-radius: 0;
    }

    .footer-main {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }

    .footer-brand {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-services div {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
    }

    .footer-bottom div {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.55rem;
    }

    .footer-bottom span {
      display: none;
    }
  }
</style>
