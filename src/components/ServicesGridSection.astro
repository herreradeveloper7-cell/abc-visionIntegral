---
import { ArrowRight, Building2, Crosshair, PackageCheck, Printer, ScanLine, Shirt, Truck } from "lucide-astro";
import { services, type ServiceIcon } from "../data/services";

const serviceIcons: Record<ServiceIcon, typeof Building2> = {
  building2: Building2,
  crosshair: Crosshair,
  packageCheck: PackageCheck,
  printer: Printer,
  scanLine: ScanLine,
  shirt: Shirt,
  truck: Truck,
};
---

<section class="services-grid-section relative bg-brand-black px-6 pb-14 pt-10">
  <div class="mx-auto grid max-w-[92rem] gap-4 md:grid-cols-2 xl:grid-cols-4">
    {
      services.map(({ icon, slug, title, shortText, image, position, categories }, index) => {
        const Icon = serviceIcons[icon];

        return (
          <article
            class="service-card"
            data-service-category={categories.join(" ")}
            style={`--service-card-delay: ${index * 120}ms;`}
          >
            <img src={image} alt={title} style={`object-position: ${position};`} />
            <div class="service-card-overlay"></div>

            <div class="service-card-content">
              <Icon size={31} strokeWidth={1.8} aria-hidden="true" />
              <h2>{title}</h2>
              <p>{shortText}</p>
              <a href={`/servicios/${slug}`}>
                <span>Conocer mas</span>
                <ArrowRight size={14} strokeWidth={2.5} aria-hidden="true" />
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .services-grid-section {
    margin-top: -1.8rem;
  }

  .service-card {
    position: relative;
    min-height: 13.6rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0.55rem;
    background: #080808;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      0 16px 34px rgba(0, 0, 0, 0.3);
    opacity: 0;
    filter: blur(12px) saturate(0.78);
    transform: translateY(2.15rem) scale(0.94);
    transform-origin: center bottom;
    animation: service-card-enter 920ms cubic-bezier(0.16, 1, 0.3, 1) var(--service-card-delay) forwards;
    will-change: opacity, filter, transform;
  }

  .service-card::before {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(115deg, transparent 0%, rgba(249, 146, 40, 0.12) 36%, rgba(249, 146, 40, 0.7) 50%, rgba(249, 146, 40, 0.12) 64%, transparent 100%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.18), transparent 34%);
    opacity: 0;
    transform: translateX(-72%) skewX(-18deg);
  }

  .service-card::after {
    content: "";
    position: absolute;
    inset: auto 14% 0;
    z-index: 2;
    height: 0.14rem;
    border-radius: 999px;
    pointer-events: none;
    background: var(--color-brand-orange);
    box-shadow:
      0 0 14px rgba(249, 146, 40, 0.88),
      0 0 32px rgba(249, 146, 40, 0.52);
    opacity: 0;
    transform: scaleX(0.25);
    transform-origin: center;
  }

  .service-card::before {
    animation: service-card-scan 900ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--service-card-delay) + 160ms) both;
  }

  .service-card::after {
    animation: service-card-energy-line 760ms ease calc(var(--service-card-delay) + 220ms) both;
  }

  .service-card[hidden] {
    display: none;
  }

  @keyframes service-card-enter {
    0% {
      opacity: 0;
      filter: blur(12px) saturate(0.78);
      transform: translateY(2.15rem) scale(0.94);
    }

    58% {
      opacity: 1;
      filter: blur(2px) saturate(1.05);
    }

    100% {
      opacity: 1;
      filter: blur(0) saturate(1);
      transform: translateY(0) scale(1);
    }
  }

  @keyframes service-card-scan {
    0% {
      opacity: 0;
      transform: translateX(-72%) skewX(-18deg);
    }

    18% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateX(72%) skewX(-18deg);
    }
  }

  @keyframes service-card-energy-line {
    0% {
      opacity: 0;
      transform: scaleX(0.25);
    }

    55% {
      opacity: 1;
      transform: scaleX(1);
    }

    100% {
      opacity: 0.82;
      transform: scaleX(0.82);
    }
  }

  .service-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.04);
    transform: scale(1.05);
  }

  .service-card-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.74) 34%, rgba(0, 0, 0, 0.22) 72%, rgba(0, 0, 0, 0.46) 100%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.16), rgba(0, 0, 0, 0.45));
  }

  .service-card-content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 13.6rem;
    height: 100%;
    max-width: 15rem;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.1rem 1.35rem;
    color: var(--color-brand-white);
  }

  .service-card-content svg {
    margin-bottom: 0.55rem;
    color: var(--color-brand-orange);
  }

  .service-card-content h2 {
    font-family: var(--font-title);
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.12;
  }

  .service-card-content p {
    margin-top: 0.5rem;
    max-width: 10rem;
    font-size: 0.72rem;
    text-align: justify;
    line-height: 1.33;
    color: rgba(255, 255, 255, 0.76);
  }

  .service-card-content a {
    position: relative;
    display: inline-flex;
    min-height: 1.95rem;
    align-items: center;
    line-height: 1;
    gap: 1.35rem;
    margin-top: auto;
    border-radius: 0.28rem;
    background: linear-gradient(90deg, #f36d07, var(--color-brand-orange));
    padding: 0 1rem;
    font-family: var(--font-title);
    font-size: 0.66rem;
    font-weight: 800;
    color: var(--color-brand-white);
    box-shadow: 0 10px 20px rgba(249, 146, 40, 0.22);
    overflow: hidden;
    transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease;
  }

  .service-card-content a:hover {
    filter: brightness(1.08);
    transform: translateY(-2px) scale(1.02);
    box-shadow:
      0 0 18px rgba(249, 146, 40, 0.58),
      0 18px 34px rgba(249, 146, 40, 0.34);
  }

  .service-card-content a::after {
    content: "";
    position: absolute;
    top: -35%;
    left: -35%;
    width: 28%;
    height: 170%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: translateX(-120%) skewX(-22deg);
    transition: transform 520ms ease;
  }

  .service-card-content a > * {
    position: relative;
    z-index: 1;
    color: var(--color-brand-white);
    opacity: 1;
  }

  .service-card-content a svg {
    color: var(--color-brand-white);
    stroke: currentColor;
    flex: 0 0 auto;
    display: block;
    transform: translateY(0.25rem);
  }

  .service-card-content a:hover::after {
    transform: translateX(520%) skewX(-22deg);
  }

  @media (max-width: 1023px) {
    .services-grid-section {
      margin-top: 0;
      padding: 2rem 1.5rem 3rem;
    }

    .service-card {
      min-height: 14rem;
    }

    .service-card-content {
      min-height: 14rem;
      max-width: 16rem;
    }
  }

  @media (max-width: 640px) {
    .services-grid-section {
      padding: 1.4rem 1rem 2.5rem;
    }

    .service-card {
      min-height: 13rem;
      border-radius: 0.45rem;
    }

    .service-card-content {
      min-height: 13rem;
      max-width: 14.5rem;
      padding: 1rem 1.15rem;
    }

    .service-card-content h2 {
      font-size: 0.98rem;
    }

    .service-card-content p {
      max-width: 11rem;
      font-size: 0.68rem;
      line-height: 1.34;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-card::before,
    .service-card::after {
      animation: none !important;
      transition: none !important;
    }

    .service-card {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }
</style>
