---
import { Cpu, Handshake, Puzzle, Wrench } from "lucide-astro";

const reasons = [
  {
    icon: Puzzle,
    title: "Soluciones a la medida",
    text: "Disenamos cada detalle para que tu marca se vea unica.",
  },
  {
    icon: Cpu,
    title: "Tecnologia de ultima generacion",
    text: "Equipos de alto rendimiento para resultados superiores y precisos.",
  },
  {
    icon: Wrench,
    title: "Instalacion profesional",
    text: "Nuestro equipo experto garantiza un acabado impecable.",
  },
  {
    icon: Handshake,
    title: "Acompanamiento integral",
    text: "Te asesoramos en cada etapa del proyecto, de principio a fin.",
  },
];
---

<section class="about-why-section">
  <div class="about-why-inner">
    <div class="about-why-copy">
      <h2>Por que <span>elegirnos?</span></h2>
      <p>Somos tu aliado estrategico para potenciar tu marca.</p>
    </div>

    <div class="about-why-panel">
      {
        reasons.map(({ icon: Icon, title, text }) => (
          <article>
            <Icon size={33} strokeWidth={1.65} aria-hidden="true" />
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about-why-section {
    position: relative;
    z-index: 1;
    width: 100%;
    margin-left: 0;
    overflow: hidden;
    color: var(--color-brand-white);
  }

  .about-why-section::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 18% 0%, rgba(255, 255, 255, 0.07), transparent 25rem),
      linear-gradient(180deg, #050505 0%, var(--color-brand-black) 100%);
  }

  .about-why-section::after {
    content: "";
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0.18rem;
    background: linear-gradient(90deg, transparent 0%, rgba(249, 146, 40, 0.52) 12%, var(--color-brand-orange) 50%, rgba(249, 146, 40, 0.52) 88%, transparent 100%);
    box-shadow:
      0 0 14px rgba(249, 146, 40, 0.82),
      0 0 30px rgba(249, 146, 40, 0.42);
  }

  .about-why-inner {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    align-items: center;
    column-gap: 2rem;
    width: min(100%, 112rem);
    min-height: 10rem;
    margin: 0 auto;
    padding: 1.55rem 7rem 1.7rem;
  }

  .about-why-copy {
    max-width: 12rem;
  }

  .about-why-copy h2 {
    font-family: var(--font-title);
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.12;
  }

  .about-why-copy h2 span {
    color: var(--color-brand-orange);
  }

  .about-why-copy p {
    margin-top: 0.75rem;
    max-width: 10.5rem;
    font-size: 0.7rem;
    line-height: 1.48;
    color: rgba(255, 255, 255, 0.68);
  }

  .about-why-panel {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    min-height: 7.4rem;
    background: linear-gradient(105deg, rgba(6, 6, 6, 0.98) 0%, rgba(29, 29, 29, 0.94) 100%);
    clip-path: polygon(2.2rem 0, 100% 0, calc(100% - 1rem) 100%, 0 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 20px 42px rgba(0, 0, 0, 0.3);
  }

  .about-why-panel article {
    position: relative;
    display: flex;
    gap: 0.58rem;
    align-items: center;
    align-content: center;
    min-width: 0;
    padding: 1.15rem 1.25rem 1rem;
  }

  .about-why-panel article > div {
    max-width: 10.8rem;
  }

  .about-why-panel article:first-child {
    padding-left: 1.75rem;
  }

  .about-why-panel article:last-child {
    padding-right: 1.55rem;
  }

  .about-why-panel article:not(:first-child)::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12%;
    width: 1px;
    height: 76%;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.18), transparent);
    transform: skewX(-14deg);
  }

  .about-why-panel svg {
    flex: 0 0 auto;
    color: var(--color-brand-orange);
    width: 1.6rem;
    height: 1.6rem;
  }

  .about-why-panel h3 {
    font-family: var(--font-title);
    font-size: 0.62rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--color-brand-white);
  }

  .about-why-panel p {
    margin-top: 0.45rem;
    font-size: 0.56rem;
    line-height: 1.42;
    color: rgba(255, 255, 255, 0.62);
  }

  @media (max-width: 1279px) {
    .about-why-inner {
      padding-right: 3rem;
      padding-left: 3rem;
    }
  }

  @media (max-width: 1023px) {
    .about-why-section {
      width: 100%;
      margin-left: 0;
    }

    .about-why-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      width: 100%;
      padding: 2rem 1.5rem 2.2rem;
    }

    .about-why-copy {
      max-width: 28rem;
    }

    .about-why-copy p {
      max-width: 22rem;
    }

    .about-why-panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      clip-path: none;
    }
  }

  @media (max-width: 640px) {
    .about-why-panel {
      grid-template-columns: 1fr;
    }

    .about-why-panel article:not(:first-child)::before {
      top: 0;
      width: 100%;
      height: 1px;
      transform: none;
    }
  }
</style>
