---
import { ArrowRight, Mail, MapPin, Phone } from "lucide-astro";
---

<aside class="about-contact">
  <div class="about-contact-base"></div>

  <div class="about-contact-panel">
    <div class="contact-copy">
      <p>Hablemos de <span>tu proyecto</span></p>
      <h2>Cuentanos tu idea y te ayudaremos a hacerla realidad.</h2>
    </div>

    <form class="contact-form">
      <div class="form-grid">
        <input type="text" name="name" placeholder="Nombre completo" aria-label="Nombre completo" />
        <input type="text" name="company" placeholder="Empresa" aria-label="Empresa" />
      </div>
      <input type="email" name="email" placeholder="Correo electronico" aria-label="Correo electronico" />
      <input type="tel" name="phone" placeholder="Telefono / WhatsApp" aria-label="Telefono o WhatsApp" />
      <textarea name="message" placeholder="Cuentanos sobre tu proyecto" aria-label="Cuentanos sobre tu proyecto"></textarea>

      <button type="submit">
        <span>Enviar mensaje</span>
        <ArrowRight size={16} strokeWidth={2.5} aria-hidden="true" />
      </button>
    </form>

    <div class="contact-data">
      <article>
        <Phone size={22} strokeWidth={2} aria-hidden="true" />
        <div>
          <strong>WhatsApp</strong>
          <span>+51 987 312 602</span>
        </div>
      </article>
      <article>
        <Mail size={22} strokeWidth={2} aria-hidden="true" />
        <div>
          <strong>Correo</strong>
          <span>gerencia@abcgestionintegral.com</span>
        </div>
      </article>
      <article>
        <MapPin size={22} strokeWidth={2} aria-hidden="true" />
        <div>
          <strong>Ubicacion</strong>
          <span> Carlos Germán amezaga 456 Lima, Perú</span>
        </div>
      </article>
    </div>

    <h3>Hacemos que tu marca <span>se vea. Se sienta. Se recuerde.</span></h3>
  </div>
</aside>

<style>
  .about-contact {
    position: relative;
    min-height: 100%;
    height: 100%;
    z-index: 3;
    padding: 7.5rem 2rem 2.5rem 4.25rem;
    overflow: visible;
    background: transparent;
    color: var(--color-brand-white);
    isolation: isolate;
  }

  .about-contact::before {
    content: "";
    position: absolute;
    inset: 0 0 0 -1.7rem;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(108, 108, 108, 0.96) 0%, rgba(35, 35, 35, 0.98) 56%, rgba(7, 7, 7, 1) 100%);
    clip-path: polygon(4.7rem 0, 100% 0, 100% 100%, 0 100%);
    pointer-events: none;
  }

  .about-contact-base {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, #050505 0%, #000 100%);
    clip-path: polygon(4rem 0, 100% 0, 100% 100%, 0 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 24px 54px rgba(0, 0, 0, 0.34);
  }

  .about-contact-panel {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.25rem;
    max-width: 34rem;
    margin-right: auto;
    padding: 1.5rem 1.5rem 0 1.5rem;
  }

  .contact-copy p {
    font-family: var(--font-title);
    font-size: 1.45rem;
    font-weight: 800;
  }

  .contact-copy p span,
  .about-contact-panel h3 span {
    color: var(--color-brand-orange);
  }

  .contact-copy h2 {
    margin-top: 0.65rem;
    max-width: 24rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.68);
  }

  .contact-form {
    display: grid;
    gap: 0.7rem;
  }

  .form-grid {
    display: grid;
    gap: 0.7rem;
    grid-template-columns: 1fr 1fr;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 0.22rem;
    background: rgba(0, 0, 0, 0.16);
    padding: 0.78rem 0.9rem;
    font-size: 0.72rem;
    color: var(--color-brand-white);
    outline: none;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .contact-form textarea {
    min-height: 6.1rem;
    resize: vertical;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: rgba(249, 146, 40, 0.72);
    box-shadow: 0 0 0 3px rgba(249, 146, 40, 0.12);
  }

  .contact-form button {
    position: relative;
    display: inline-flex;
    width: max-content;
    min-height: 2.75rem;
    align-items: center;
    gap: 2rem;
    overflow: hidden;
    border-radius: 0.28rem;
    background: linear-gradient(90deg, #f36d07 0%, var(--color-brand-orange) 100%);
    padding: 0 1.55rem;
    font-family: var(--font-title);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-brand-white);
    transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease;
  }

  .contact-form button::after {
    content: "";
    position: absolute;
    top: -35%;
    left: -35%;
    width: 28%;
    height: 170%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: translateX(-120%) skewX(-22deg);
    transition: transform 520ms ease;
  }

  .contact-form button > * {
    position: relative;
    z-index: 1;
  }

  .contact-form button:hover {
    filter: brightness(1.08);
    transform: translateY(-2px) scale(1.02);
    box-shadow:
      0 0 18px rgba(249, 146, 40, 0.58),
      0 18px 34px rgba(249, 146, 40, 0.34);
  }

  .contact-form button:hover::after {
    transform: translateX(520%) skewX(-22deg);
  }

  .contact-data {
    display: grid;
    grid-template-columns: 0.9fr 1.35fr 0.95fr;
    gap: 0;
    margin-top: 0.7rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    padding-top: 1rem;
  }

  .contact-data article {
    position: relative;
    display: flex;
    gap: 0.72rem;
    align-items: center;
    min-width: 0;
    padding: 0 1.15rem;
  }

  .contact-data article:first-child {
    padding-left: 0;
  }

  .contact-data article:not(:first-child)::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12%;
    width: 1px;
    height: 76%;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.22), transparent);
  }

  .contact-data svg {
    flex: 0 0 auto;
    color: var(--color-brand-orange);
  }

  .contact-data strong,
  .contact-data span {
    display: block;
    font-size: 0.62rem;
    line-height: 1.3;
  }

  .contact-data span {
    color: rgba(255, 255, 255, 0.68);
    overflow-wrap: anywhere;
  }

  .about-contact-panel h3 {
    margin-top: 1.2rem;
    max-width: 30rem;
    font-family: var(--font-title);
    font-size: 1.75rem;
    font-weight: 800;
    font-style: italic;
    line-height: 1.15;
  }

  @media (max-width: 1023px) {
    .about-contact {
      min-height: auto;
      padding: 2rem 1rem;
      overflow: hidden;
    }

    .about-contact::before {
      inset: 0;
      clip-path: none;
    }

    .about-contact-base {
      inset: 0;
      clip-path: none;
    }

    .about-contact-panel {
      max-width: none;
      margin: 0;
    }
  }

  @media (max-width: 640px) {
    .form-grid,
    .contact-data {
      grid-template-columns: 1fr;
    }

    .contact-data {
      gap: 0.85rem;
    }

    .contact-data article {
      padding: 0;
    }

    .contact-data article:not(:first-child)::before {
      display: none;
    }
  }
</style>
