---
import { Building2, ChevronDown, ChevronUp, Factory, ShoppingCart, Star } from "lucide-astro";

const sectors = [
  {
    icon: ShoppingCart,
    title: "Retail",
    description: "Soluciones visuales para tiendas, vitrinas, puntos de venta y experiencias comerciales que guian la compra y fortalecen la presencia de marca.",
  },
  {
    icon: Building2,
    title: "Corporativo",
    description: "Comunicacion visual para oficinas, sedes y espacios empresariales que transmite confianza, orden y una identidad profesional consistente.",
  },
  {
    icon: Factory,
    title: "Industria",
    description: "Senalizacion, marcacion e implementaciones resistentes para plantas, bodegas y entornos operativos donde la claridad y la durabilidad importan.",
  },
  {
    icon: Star,
    title: "Ferias y Eventos",
    description: "Stands, piezas promocionales y recursos visuales pensados para atraer visitantes, contar tu propuesta y hacer memorable cada activacion.",
  },
];
---

<section class="about-sectors-section">
  <div class="about-sectors-inner">
    <div class="about-sectors-copy">
      <h2>Trabajamos en <span>multiples sectores</span></h2>
      <p>Entendemos tu industria y potenciamos tu marca.</p>
    </div>

    <div class="about-sectors-grid">
      {
        sectors.map(({ icon: Icon, title, description }) => (
          <article class="sector-card" data-sector-card>
            <button class="sector-trigger" type="button" aria-expanded="false">
              <span class="sector-title">
                <h3>{title}</h3>
                <Icon class="sector-main-icon" size={23} strokeWidth={1.75} aria-hidden="true" />
              </span>
              <span class="sector-toggle" aria-hidden="true">
                <ChevronDown class="sector-toggle-down" size={17} strokeWidth={2.2} />
                <ChevronUp class="sector-toggle-up" size={17} strokeWidth={2.2} />
              </span>
            </button>

            <div class="sector-description" aria-hidden="true">
              <p>{description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const sectorCards = document.querySelectorAll<HTMLElement>("[data-sector-card]");

  sectorCards.forEach((card) => {
    const trigger = card.querySelector<HTMLButtonElement>(".sector-trigger");
    const description = card.querySelector<HTMLElement>(".sector-description");

    trigger?.addEventListener("click", () => {
      const isOpen = card.classList.toggle("is-open");
      trigger.setAttribute("aria-expanded", String(isOpen));
      description?.setAttribute("aria-hidden", String(!isOpen));
    });
  });
</script>

<style>
  .about-sectors-section {
    position: relative;
    z-index: 1;
    width: 100%;
    margin-left: 0;
    overflow: hidden;
    color: var(--color-brand-black);
  }

  .about-sectors-section::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 22% 0%, rgba(255, 255, 255, 0.9), transparent 24rem),
      linear-gradient(180deg, #f6f6f4 0%, #ececea 100%);
  }

  .about-sectors-section::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0.12rem;
    background: linear-gradient(90deg, transparent 0%, rgba(249, 146, 40, 0.48) 12%, var(--color-brand-orange) 50%, rgba(249, 146, 40, 0.48) 88%, transparent 100%);
  }

  .about-sectors-inner {
    display: grid;
    grid-template-columns: 14.4rem minmax(0, 1fr);
    align-items: center;
    column-gap: 1.5rem;
    width: min(100%, 112rem);
    min-height: 7.1rem;
    margin: 0 auto;
    padding: 1.45rem 7rem 1.55rem;
  }

  .about-sectors-copy h2 {
    font-family: var(--font-title);
    font-size: 1.12rem;
    font-weight: 800;
    line-height: 1.15;
  }

  .about-sectors-copy h2 span {
    color: var(--color-brand-orange);
  }

  .about-sectors-copy p {
    margin-top: 0.55rem;
    max-width: 13rem;
    font-size: 0.7rem;
    line-height: 1.45;
    color: rgba(0, 0, 0, 0.62);
  }

  .about-sectors-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .about-sectors-grid article {
    position: relative;
    display: block;
    min-height: 3.7rem;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 0.22rem;
    background: rgba(255, 255, 255, 0.74);
    box-shadow:
      0 10px 24px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .about-sectors-grid article::before {
    content: "";
    position: absolute;
    inset: -1px;
    background: linear-gradient(115deg, transparent 0%, rgba(249, 146, 40, 0.22) 42%, rgba(249, 146, 40, 0.5) 50%, rgba(249, 146, 40, 0.22) 58%, transparent 100%);
    opacity: 0;
    transform: translateX(-58%) skewX(-18deg);
    transition: opacity 180ms ease, transform 620ms ease;
  }

  .about-sectors-grid article::after {
    content: "";
    position: absolute;
    inset: auto 16% 0;
    height: 0.13rem;
    border-radius: 999px;
    background: var(--color-brand-orange);
    box-shadow: 0 0 16px rgba(249, 146, 40, 0.76);
    opacity: 0;
    transform: scaleX(0.35);
    transition: opacity 180ms ease, transform 220ms ease;
  }

  .about-sectors-grid article:hover,
  .about-sectors-grid article.is-open {
    border-color: rgba(249, 146, 40, 0.58);
    background: rgba(255, 255, 255, 0.95);
    box-shadow:
      0 0 18px rgba(249, 146, 40, 0.34),
      0 18px 34px rgba(0, 0, 0, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 1);
    transform: translateY(-0.28rem);
  }

  .about-sectors-grid article:hover::before,
  .about-sectors-grid article.is-open::before {
    opacity: 1;
    transform: translateX(58%) skewX(-18deg);
  }

  .about-sectors-grid article:hover::after,
  .about-sectors-grid article.is-open::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .sector-trigger {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3.7rem;
    gap: 0.62rem;
    padding: 0 1rem;
    text-align: center;
    color: inherit;
  }

  .sector-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.15rem;
    min-width: 0;
  }

  .sector-toggle {
    position: relative;
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(249, 146, 40, 0.2);
    border-radius: 999px;
    color: var(--color-brand-orange);
    background: rgba(255, 255, 255, 0.6);
    box-shadow: inset 0 0 12px rgba(249, 146, 40, 0.08);
    transition: background-color 180ms ease, box-shadow 220ms ease, transform 220ms ease;
  }

  .sector-toggle svg {
    grid-area: 1 / 1;
    transition: opacity 180ms ease, transform 240ms ease;
  }

  .sector-toggle-up {
    opacity: 0;
    transform: translateY(0.25rem) scale(0.7);
  }

  .sector-description {
    position: relative;
    z-index: 1;
    max-height: 0;
    overflow: hidden;
    padding: 0 1.05rem;
    opacity: 0;
    transform: translateY(-0.25rem);
    transition:
      max-height 360ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 220ms ease,
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
      padding 260ms ease;
  }

  .sector-description p {
    font-size: 0.62rem;
    line-height: 1.42;
    text-align: left;
    color: rgba(0, 0, 0, 0.66);
  }

  .sector-card.is-open {
    min-height: 7.9rem;
  }

  .sector-card.is-open .sector-description {
    max-height: 6.5rem;
    padding: 0 1.05rem 0.95rem;
    opacity: 1;
    transform: translateY(0);
  }

  .sector-card.is-open .sector-toggle {
    background: rgba(249, 146, 40, 0.12);
    box-shadow:
      0 0 14px rgba(249, 146, 40, 0.35),
      inset 0 0 14px rgba(249, 146, 40, 0.12);
    transform: scale(1.04);
  }

  .sector-card.is-open .sector-toggle-down {
    opacity: 0;
    transform: translateY(-0.25rem) scale(0.7);
  }

  .sector-card.is-open .sector-toggle-up {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .about-sectors-grid h3 {
    position: relative;
    z-index: 1;
    font-family: var(--font-title);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1.1;
    transition: color 180ms ease, transform 220ms ease;
  }

  .about-sectors-grid .sector-main-icon {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    color: rgba(0, 0, 0, 0.42);
    transition: color 180ms ease, filter 220ms ease, transform 220ms ease;
  }

  .about-sectors-grid article:hover h3,
  .about-sectors-grid article.is-open h3 {
    color: var(--color-brand-orange);
    transform: translateX(-0.1rem);
  }

  .about-sectors-grid article:hover .sector-main-icon,
  .about-sectors-grid article.is-open .sector-main-icon {
    color: var(--color-brand-orange);
    filter: drop-shadow(0 0 8px rgba(249, 146, 40, 0.55));
    transform: translateX(0.12rem) scale(1.12) rotate(-4deg);
  }

  @media (max-width: 1023px) {
    .about-sectors-section {
      width: 100%;
      margin-left: 0;
    }

    .about-sectors-inner {
      grid-template-columns: 1fr;
      gap: 1.35rem;
      width: 100%;
      padding: 1.8rem 1.5rem;
    }

    .about-sectors-copy p {
      max-width: 24rem;
    }

    .about-sectors-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .about-sectors-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
