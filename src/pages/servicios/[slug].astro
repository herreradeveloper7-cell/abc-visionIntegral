---
import { ArrowRight, Building2, CheckCircle2, Crosshair, PackageCheck, Printer, ScanLine, Shirt, Truck } from "lucide-astro";
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { services, type Service, type ServiceIcon } from "../../data/services";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;

const serviceIcons: Record<ServiceIcon, typeof Building2> = {
  building2: Building2,
  crosshair: Crosshair,
  packageCheck: PackageCheck,
  printer: Printer,
  scanLine: ScanLine,
  shirt: Shirt,
  truck: Truck,
};

const Icon = serviceIcons[service.icon];
const relatedServices = services.filter((item) => item.slug !== service.slug).slice(0, 3);
---

<BaseLayout
  title={`${service.title} | ABC Vision Integral`}
  description={service.summary}
>
  <Header />

  <main class="service-detail-page">
    <section class="service-detail-hero">
      <div class="service-detail-copy">
        <div class="service-detail-line" aria-hidden="true"></div>
        <a class="service-detail-back" href="/servicios">Servicios</a>
        <p>{service.eyebrow}</p>
        <h1>{service.title}</h1>
        <span>{service.summary}</span>

        <div class="service-detail-actions">
          <a href="/contacto">
            <span>Solicitar asesoria</span>
            <ArrowRight size={16} strokeWidth={2.5} aria-hidden="true" />
          </a>
        </div>
      </div>

      <div class="service-detail-visual">
        <img src={service.image} alt={service.title} style={`object-position: ${service.position};`} />
        <div class="service-detail-visual-overlay"></div>
        <div class="service-detail-badge">
          <Icon size={36} strokeWidth={1.75} aria-hidden="true" />
          <strong>Solucion integral</strong>
        </div>
      </div>
    </section>

    <section class="service-detail-content">
      <div class="service-detail-intro">
        <h2>Que hacemos por tu marca</h2>
        <p>{service.description}</p>
      </div>

      <div class="service-feature-panel">
        {
          service.features.map((feature) => (
            <article>
              <CheckCircle2 size={21} strokeWidth={1.9} aria-hidden="true" />
              <span>{feature}</span>
            </article>
          ))
        }
      </div>
    </section>

    <section class="service-uses-section">
      <div class="service-uses-copy">
        <h2>Aplicaciones frecuentes</h2>
        <p>Adaptamos cada entrega al objetivo, superficie, entorno y experiencia que necesita comunicar tu marca.</p>
      </div>

      <div class="service-uses-grid">
        {
          service.uses.map((use, index) => (
            <article data-reveal-use style={`--reveal-delay: ${index * 80}ms;`}>{use}</article>
          ))
        }
      </div>
    </section>

    <section class="service-related-section">
      <div class="service-related-header">
        <h2>Tambien puede interesarte</h2>
        <a href="/servicios">Ver todos</a>
      </div>

      <div class="service-related-grid">
        {
          relatedServices.map((item) => {
            const RelatedIcon = serviceIcons[item.icon];

            return (
              <a href={`/servicios/${item.slug}`}>
                <RelatedIcon size={25} strokeWidth={1.75} aria-hidden="true" />
                <strong>{item.title}</strong>
                <span>{item.shortText}</span>
              </a>
            );
          })
        }
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal-use]");

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.22 },
    );

    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  }
</script>

<style>
  .service-detail-page {
    overflow: hidden;
    background:
      radial-gradient(circle at 2rem 9rem, rgba(5, 49, 60, 0.1) 0 1px, transparent 1px),
      var(--color-brand-white);
    background-size: 0.8rem 0.8rem;
  }

  .service-detail-hero {
    display: grid;
    grid-template-columns: minmax(0, 44%) minmax(0, 56%);
    min-height: 34rem;
    padding-top: 5rem;
  }

  .service-detail-copy {
    position: relative;
    display: grid;
    align-content: center;
    justify-self: end;
    width: min(34rem, 100%);
    padding: 4rem 2.8rem 4rem 0;
  }

  .service-detail-line {
    position: absolute;
    left: -2rem;
    top: 12.2rem;
    width: 0.12rem;
    height: 6rem;
    border-radius: 999px;
    background: var(--color-brand-orange);
  }

  .service-detail-back,
  .service-detail-copy > p {
    font-family: var(--font-title);
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-brand-orange);
  }

  .service-detail-back {
    width: max-content;
    margin-bottom: 0.55rem;
    color: rgba(0, 0, 0, 0.48);
    transition: color 180ms ease;
  }

  .service-detail-back:hover {
    color: var(--color-brand-orange);
  }

  .service-detail-copy h1 {
    margin-top: 0.9rem;
    font-family: var(--font-title);
    font-size: clamp(1.5rem, 2.15vw, 2.6rem);
    font-weight: 800;
    font-style: italic;
    line-height: 1.08;
    color: var(--color-brand-black);
  }

  .service-detail-copy > span {
    margin-top: 1rem;
    max-width: 30rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.66);
  }

  .service-detail-actions {
    margin-top: 1.45rem;
  }

  .service-detail-actions a {
    position: relative;
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    gap: 1.5rem;
    overflow: hidden;
    border-radius: 0.32rem;
    background: linear-gradient(90deg, #f36d07 0%, var(--color-brand-orange) 100%);
    padding: 0 1.35rem;
    font-family: var(--font-title);
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--color-brand-white);
    box-shadow: 0 14px 30px rgba(249, 146, 40, 0.24);
    transition: box-shadow 180ms ease, filter 180ms ease, transform 180ms ease;
  }

  .service-detail-actions a::after {
    content: "";
    position: absolute;
    top: -35%;
    left: -35%;
    width: 28%;
    height: 170%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: translateX(-120%) skewX(-22deg);
    transition: transform 520ms ease;
  }

  .service-detail-actions a > * {
    position: relative;
    z-index: 1;
  }

  .service-detail-actions a:hover {
    filter: brightness(1.08);
    box-shadow:
      0 0 18px rgba(249, 146, 40, 0.58),
      0 18px 34px rgba(249, 146, 40, 0.34);
    transform: translateY(-0.12rem) scale(1.02);
  }

  .service-detail-actions a:hover::after {
    transform: translateX(520%) skewX(-22deg);
  }

  .service-detail-visual {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    background: var(--color-brand-black);
    clip-path: polygon(clamp(12rem, 24vw, 30rem) 0, 100% 0, 100% 100%, 0 100%);
  }

  .service-detail-visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
  }

  .service-detail-visual-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.12)),
      linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.42));
  }

  .service-detail-badge {
    position: absolute;
    right: clamp(2rem, 6vw, 6rem);
    bottom: 3rem;
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(5, 5, 5, 0.76);
    padding: 1rem 1.25rem;
    color: var(--color-brand-white);
    box-shadow:
      0 0 18px rgba(249, 146, 40, 0.24),
      0 18px 38px rgba(0, 0, 0, 0.32);
    backdrop-filter: blur(6px);
  }

  .service-detail-badge svg {
    color: var(--color-brand-orange);
  }

  .service-detail-badge strong {
    font-family: var(--font-title);
    font-size: 0.78rem;
  }

  .service-detail-content,
  .service-uses-section,
  .service-related-section {
    display: grid;
    grid-template-columns: minmax(16rem, 0.8fr) minmax(0, 1.8fr);
    gap: 2rem;
    width: min(100%, 96rem);
    margin: 0 auto;
    padding: 2.6rem 7rem;
  }

  .service-detail-content {
    position: relative;
    z-index: 1;
    isolation: isolate;
    background: transparent;
    color: var(--color-brand-white);
  }

  .service-detail-content::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: -1;
    width: 100vw;
    background:
      radial-gradient(circle at 82% 18%, rgba(255, 255, 255, 0.08), transparent 18rem),
      linear-gradient(180deg, #060606 0%, #000 100%);
    transform: translateX(-50%);
  }

  .service-detail-content::after {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    z-index: -1;
    width: 100vw;
    height: 0.12rem;
    background: linear-gradient(90deg, transparent 0%, rgba(249, 146, 40, 0.42) 14%, var(--color-brand-orange) 50%, rgba(249, 146, 40, 0.42) 86%, transparent 100%);
    box-shadow:
      0 0 10px rgba(249, 146, 40, 0.65),
      0 0 24px rgba(249, 146, 40, 0.34);
    transform: translateX(-50%);
  }

  .service-detail-intro h2,
  .service-uses-copy h2,
  .service-related-header h2 {
    font-family: var(--font-title);
    font-size: 1.35rem;
    font-weight: 800;
    font-style: italic;
    line-height: 1.12;
  }

  .service-detail-intro p,
  .service-uses-copy p {
    margin-top: 0.8rem;
    max-width: 25rem;
    font-size: 0.82rem;
    line-height: 1.58;
    color: rgba(255, 255, 255, 0.68);
  }

  .service-feature-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .service-feature-panel article {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.7rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: linear-gradient(180deg, rgba(28, 28, 28, 0.96), rgba(12, 12, 12, 0.98));
    padding: 0.85rem;
  }

  .service-feature-panel svg {
    flex: 0 0 auto;
    color: var(--color-brand-orange);
  }

  .service-feature-panel span {
    font-size: 0.78rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.78);
  }

  .service-uses-section,
  .service-related-section {
    background: var(--color-brand-white);
  }

  .service-uses-copy p {
    color: rgba(0, 0, 0, 0.64);
  }

  .service-uses-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .service-uses-grid article,
  .service-related-grid a {
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.06);
  }

  .service-uses-grid article {
    display: grid;
    min-height: 3.25rem;
    place-items: center;
    padding: 0.75rem;
    font-family: var(--font-title);
    font-size: 0.72rem;
    font-weight: 800;
    text-align: center;
    opacity: 0;
    transform: translateY(1rem) scale(0.96);
    transition:
      opacity 520ms ease var(--reveal-delay),
      transform 620ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay),
      border-color 180ms ease,
      box-shadow 220ms ease,
      color 180ms ease;
  }

  .service-uses-grid article.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .service-uses-grid article.is-visible:hover {
    border-color: rgba(249, 146, 40, 0.58);
    color: var(--color-brand-orange);
    box-shadow:
      0 0 18px rgba(249, 146, 40, 0.28),
      0 18px 34px rgba(0, 0, 0, 0.12);
    transform: translateY(-0.25rem) scale(1.02);
  }

  .service-related-section {
    padding-top: 1rem;
  }

  .service-related-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .service-related-header a {
    font-family: var(--font-title);
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--color-brand-orange);
  }

  .service-related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .service-related-grid a {
    display: grid;
    gap: 0.45rem;
    min-height: 8rem;
    padding: 1rem;
    color: var(--color-brand-black);
    transition: border-color 180ms ease, box-shadow 220ms ease, transform 220ms ease;
  }

  .service-related-grid a:hover {
    border-color: rgba(249, 146, 40, 0.58);
    box-shadow:
      0 0 18px rgba(249, 146, 40, 0.28),
      0 18px 34px rgba(0, 0, 0, 0.12);
    transform: translateY(-0.25rem);
  }

  .service-related-grid svg {
    color: var(--color-brand-orange);
  }

  .service-related-grid strong {
    font-family: var(--font-title);
    font-size: 0.82rem;
    line-height: 1.18;
  }

  .service-related-grid span {
    font-size: 0.68rem;
    line-height: 1.42;
    color: rgba(0, 0, 0, 0.62);
  }

  @media (max-width: 1023px) {
    .service-detail-hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 5.4rem;
    }

    .service-detail-copy {
      justify-self: start;
      width: auto;
      max-width: 42rem;
      padding: 4rem clamp(1.5rem, 6vw, 4rem) 2.4rem;
    }

    .service-detail-line {
      display: none;
    }

    .service-detail-visual {
      min-height: clamp(18rem, 48vw, 25rem);
      clip-path: none;
    }

    .service-detail-content,
    .service-uses-section,
    .service-related-section {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 2rem clamp(1.5rem, 6vw, 4rem);
    }

    .service-related-grid,
    .service-uses-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .service-detail-hero {
      padding-top: 4.9rem;
    }

    .service-detail-copy {
      padding: 2.4rem 1.2rem 1.8rem;
    }

    .service-detail-copy h1 {
      font-size: 2rem;
    }

    .service-detail-badge {
      left: 1rem;
      right: 1rem;
      bottom: 1rem;
      justify-content: center;
    }

    .service-detail-content,
    .service-uses-section,
    .service-related-section {
      padding: 1.7rem 1rem;
    }

    .service-feature-panel,
    .service-related-grid,
    .service-uses-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
