---
import { ArrowRight, Clock3, MessageCircle, Sparkles } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
---

<BaseLayout
  title="Contacto | ABC Vision Integral"
  description="Estamos preparando la pagina de contacto de ABC Vision Integral."
>
  <Header />
  <main class="contact-placeholder-page">
    <section class="contact-placeholder-hero">
      <div class="placeholder-copy">
        <p class="placeholder-eyebrow">Contacto</p>
        <h1>Estamos trabajando en esta pagina...</h1>
        <p>
          Muy pronto tendras aqui una experiencia completa para cotizar, agendar y contarnos tu proyecto con todo el detalle que merece tu marca.
        </p>

        <div class="placeholder-actions">
          <a href="https://wa.me/573001234567" target="_blank" rel="noreferrer">
            <span>Escribenos por WhatsApp</span>
            <ArrowRight size={16} strokeWidth={2.5} aria-hidden="true" />
          </a>
        </div>
      </div>

    </section>
  </main>
</BaseLayout>

<style>
  .contact-placeholder-page {
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 7rem 15rem, rgba(5, 49, 60, 0.1) 0 1px, transparent 1px),
      var(--color-brand-white);
    background-size: 0.8rem 0.8rem;
  }

  .contact-placeholder-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(24rem, 1.08fr);
    align-items: center;
    min-height: 45rem;
    padding: 8.5rem 7rem 5rem;
  }

  .contact-placeholder-hero::before {
    content: "";
    position: absolute;
    top: 0;
    right: -13rem;
    bottom: 0;
    width: min(58rem, 62vw);
    background:
  }

  .placeholder-copy {
    position: relative;
    z-index: 2;
    max-width: 38rem;
  }

  .placeholder-copy::before {
    content: "";
    position: absolute;
    left: -2rem;
    top: 0.35rem;
    width: 0.12rem;
    height: 6.2rem;
    border-radius: 999px;
    background: var(--color-brand-orange);
  }

  .placeholder-eyebrow {
    font-family: var(--font-title);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-brand-orange);
  }

  .placeholder-copy h1 {
    margin-top: 1rem;
    font-family: var(--font-title);
    font-size: clamp(2.6rem, 4vw, 4.9rem);
    font-weight: 800;
    font-style: italic;
    line-height: 1.05;
    color: var(--color-brand-black);
  }

  .placeholder-copy > p:not(.placeholder-eyebrow) {
    margin-top: 1.25rem;
    max-width: 33rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgba(0, 0, 0, 0.66);
  }

  .placeholder-actions {
    margin-top: 2rem;
  }

  .placeholder-actions a {
    position: relative;
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: 1.5rem;
    overflow: hidden;
    border-radius: 0.32rem;
    background: linear-gradient(90deg, #f36d07 0%, var(--color-brand-orange) 100%);
    padding: 0 1.35rem;
    font-family: var(--font-title);
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--color-brand-white);
    transition: box-shadow 180ms ease, filter 180ms ease, transform 180ms ease;
  }

  .placeholder-actions a::after {
    content: "";
    position: absolute;
    top: -35%;
    left: -35%;
    width: 28%;
    height: 170%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: translateX(-120%) skewX(-22deg);
    transition: transform 520ms ease;
  }

  .placeholder-actions a > * {
    position: relative;
    z-index: 1;
  }

  .placeholder-actions a:hover {
    filter: brightness(1.08);
    box-shadow:
      0 0 18px rgba(249, 146, 40, 0.58),
      0 18px 34px rgba(249, 146, 40, 0.28);
    transform: translateY(-0.12rem);
  }

  .panel-icon {
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    border: 1px solid rgba(249, 146, 40, 0.45);
    color: var(--color-brand-orange);
    box-shadow: 0 0 18px rgba(249, 146, 40, 0.28);
  }

  .placeholder-panel h2 {
    font-family: var(--font-title);
    font-size: 1.45rem;
    font-weight: 800;
  }

  .placeholder-panel p {
    margin-top: 0.6rem;
    max-width: 24rem;
    font-size: 0.82rem;
    line-height: 1.58;
    color: rgba(255, 255, 255, 0.68);
  }

  .placeholder-status {
    display: grid;
    gap: 0.7rem;
    margin-top: 0.35rem;
  }

  .placeholder-status article {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 3.15rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.035);
    padding: 0 0.95rem;
  }

  .placeholder-status svg {
    color: var(--color-brand-orange);
  }

  .placeholder-status span {
    font-family: var(--font-title);
    font-size: 0.72rem;
    font-weight: 800;
  }

  @keyframes placeholder-shine {
    0%,
    45% {
      transform: translateX(-75%) skewX(-18deg);
    }

    100% {
      transform: translateX(85%) skewX(-18deg);
    }
  }

  @media (max-width: 1023px) {
    .contact-placeholder-hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 8rem 1.5rem 3rem;
    }

    .contact-placeholder-hero::before {
      top: auto;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 50%;
      clip-path: none;
    }

    .placeholder-panel {
      justify-self: stretch;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .placeholder-copy::before {
      display: none;
    }

    .placeholder-copy h1 {
      font-size: 2.4rem;
    }

    .placeholder-panel {
      padding: 1.4rem;
    }
  }
</style>
