---
import { ArrowRight, Clock3, MessageCircle } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import AboutContactPanel from "../components/AboutContactPanel.astro";
---

<BaseLayout
  title="Contacto | ABC Vision Integral"
  description="Contacta a ABC Vision Integral para cotizar soluciones visuales para tu marca."
>
  <Header />
  <main class="contact-page">
    <section class="contact-layout">
      <div class="contact-copy">
        <div class="contact-copy-inner">
          <div class="contact-copy-line" aria-hidden="true"></div>
          <p class="contact-eyebrow">Contacto</p>
          <h1>
            Conversemos sobre el proximo paso de
            <span>tu marca.</span>
          </h1>
          <p class="contact-summary">
            Cuentanos que necesitas producir, instalar o transformar. Nuestro equipo te ayudara a convertir tu idea en una solucion visual clara, precisa y memorable.
          </p>

          <div class="contact-notes">
            <article>
              <MessageCircle size={24} strokeWidth={1.85} aria-hidden="true" />
              <div>
                <strong>Respuesta directa</strong>
                <span>Escribenos por WhatsApp para una asesoria inicial.</span>
              </div>
            </article>
            <article>
              <Clock3 size={24} strokeWidth={1.85} aria-hidden="true" />
              <div>
                <strong>Acompanamiento claro</strong>
                <span>Te orientamos desde la idea hasta la entrega final.</span>
              </div>
            </article>
          </div>
        </div>
      </div>

      <div class="contact-form-slot">
        <AboutContactPanel />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .contact-page {
    overflow: hidden;
    background:
      radial-gradient(circle at 7rem 15rem, rgba(5, 49, 60, 0.1) 0 1px, transparent 1px),
      var(--color-brand-white);
    background-size: 0.8rem 0.8rem;
    padding-top: 5rem;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 44%) minmax(0, 56%);
    align-items: stretch;
    min-height: 33rem;
  }

  .contact-copy {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 3.5rem 0 3.5rem 7rem;
  }

  .contact-copy-inner {
    position: relative;
    width: min(34rem, 100%);
    padding-right: 2.8rem;
  }

  .contact-copy-line {
    position: absolute;
    left: -2rem;
    top: 3.75rem;
    width: 0.12rem;
    height: 5.8rem;
    border-radius: 999px;
    background: var(--color-brand-orange);
  }

  .contact-eyebrow {
    font-family: var(--font-title);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-brand-orange);
  }

  .contact-copy h1 {
    margin-top: 0.85rem;
    font-family: var(--font-title);
    font-size: clamp(1.5rem, 2.15vw, 2.6rem);
    font-weight: 800;
    font-style: italic;
    line-height: 1.04;
    color: var(--color-brand-black);
  }

  .contact-copy h1 span {
    color: var(--color-brand-orange);
  }

  .contact-summary {
    margin-top: 1rem;
    max-width: 30rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.66);
  }

  .contact-notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.25rem;
    max-width: 31rem;
  }

  .contact-notes article {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 4.35rem;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: rgba(255, 255, 255, 0.74);
    padding: 0.8rem;
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.06);
  }

  .contact-notes svg {
    flex: 0 0 auto;
    color: var(--color-brand-orange);
  }

  .contact-notes strong,
  .contact-notes span {
    display: block;
  }

  .contact-notes strong {
    font-family: var(--font-title);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .contact-notes span {
    margin-top: 0.28rem;
    font-size: 0.66rem;
    line-height: 1.45;
    color: rgba(0, 0, 0, 0.62);
  }

  .contact-form-slot {
    min-width: 0;
    margin-left: clamp(1.5rem, 2.6vw, 3.5rem);
  }

  @media (max-width: 1279px) {
    .contact-layout {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .contact-copy {
      justify-content: flex-start;
      padding: 4rem 3rem 2.4rem;
    }

    .contact-copy-inner {
      max-width: 38rem;
      padding-right: 0;
    }

    .contact-copy h1 {
      font-size: clamp(1.5rem, 2.15vw, 2.6rem);
    }

    .contact-copy-line {
      display: none;
    }

    .contact-form-slot {
      margin-left: 0;
      padding-top: 0;
    }
  }

  @media (max-width: 640px) {
    .contact-page {
      padding-top: 4.8rem;
    }

    .contact-copy {
      padding: 2.4rem 1.25rem 1.6rem;
    }

    .contact-copy h1 {
      font-size: 2rem;
    }

    .contact-notes {
      grid-template-columns: 1fr;
    }
  }
</style>
