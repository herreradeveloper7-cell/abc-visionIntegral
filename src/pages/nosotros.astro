---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import AboutHeroSection from "../components/AboutHeroSection.astro";
import AboutWhyChooseSection from "../components/AboutWhyChooseSection.astro";
import AboutSectorsSection from "../components/AboutSectorsSection.astro";
---

<BaseLayout
  title="Nosotros | ABC Vision Integral"
  description="Conoce la historia, experiencia y equipo detras de ABC Vision Integral."
>
  <Header />
  <main class="about-page bg-brand-white">
    <AboutHeroSection />
    <AboutWhyChooseSection />
    <AboutSectorsSection />
  </main>
</BaseLayout>

<style>
  .about-page {
    overflow: hidden;
    background:
      radial-gradient(circle at 2rem 13rem, rgba(5, 49, 60, 0.1) 0 1px, transparent 1px),
      var(--color-brand-white);
    background-size: 0.8rem 0.8rem;
  }
</style>
